            "type": "grafana-clickhouse-datasource",
            "uid": "nyquist-clickhouse"
          },
          "format": 1,
          "rawSql": "SELECT ts, maxIf(p50, name='process_cpu_user') AS \"User p50\", maxIf(p90, name='process_cpu_user') AS \"User p90\", maxIf(p99, name='process_cpu_user') AS \"User p99\", maxIf(p999, name='process_cpu_user') AS \"User p999\", maxIf(p50, name='process_cpu_system') AS \"System p50\", maxIf(p90, name='process_cpu_system') AS \"System p90\", maxIf(p99, name='process_cpu_system') AS \"System p99\", maxIf(p999, name='process_cpu_system') AS \"System p999\" FROM nyquist_live.samples WHERE name IN ('process_cpu_user','process_cpu_system') AND $__timeFilter(ts) GROUP BY ts ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "CPU cost \u2014 all percentiles (100 jiffies/s = 100% of 1 core)",
      "type": "timeseries"
