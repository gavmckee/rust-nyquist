{
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true
  },
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--network", "host",
        "-e", "GRAFANA_URL=http://localhost:3000",
        "grafana/mcp-grafana:latest"
      ]
    }
  }
}
